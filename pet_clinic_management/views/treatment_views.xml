<odoo>
    <record id="vet_treatment_form" model="ir.ui.view">
        <field name="name">vet.treatment.form</field>
        <field name="model">vet.treatment</field>
        <field name="arch" type="xml">
            <form string="Treatment">
                <sheet>
                    <group>
                        <field name="appointment_id"/>
                        <field name="pet_id"/>
                        <field name="breed" readonly="1"/>
                        <field name="age" readonly="1"/>
                        <field name="treatment_date"/>
                        <field name="veterinarian"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vet_treatment_tree" model="ir.ui.view">
        <field name="name">vet.treatment.tree</field>
        <field name="model">vet.treatment</field>
        <field name="arch" type="xml">
            <list>
                <field name="pet_id"/>
                <field name="appointment_id"/>
                <field name="treatment_date"/>
                <field name="veterinarian"/>
            </list>
        </field>
    </record>

    <record id="vet_treatment_action" model="ir.actions.act_window">
        <field name="name">Treatments</field>
        <field name="res_model">vet.treatment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="vet_treatment_menu" name="Treatments" parent="vet_clinic_root" action="vet_treatment_action"
              groups="base.group_user"/>
</odoo>
