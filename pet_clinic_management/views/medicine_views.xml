<odoo>
    <record id="view_vet_medicine_form" model="ir.ui.view">
        <field name="name">vet.medicine.form</field>
        <field name="model">vet.medicine</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vet_medicine_tree" model="ir.ui.view">
        <field name="name">vet.medicine.tree</field>
        <field name="model">vet.medicine</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_vet_medicine" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">vet.medicine</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="vet_medicine_menu" name="Medicines"
              parent="vet_config_menu" action="action_vet_medicine"
              sequence="2" groups="base.group_user"/>
</odoo>
