<odoo>
    <record id="vet_prescription_form" model="ir.ui.view">
        <field name="name">vet.prescription.form</field>
        <field name="model">vet.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">
                <sheet>
                    <group>
                        <field name="appointment_id"/>
                        <field name="pet_id"/>
                        <field name="instructions"/>
                    </group>
                    <notebook>
                        <page string="Medicines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="medicine_id"/>
                                    <field name="dosage"/>
                                    <field name="instructions"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vet_prescription_tree" model="ir.ui.view">
        <field name="name">vet.prescription.tree</field>
        <field name="model">vet.prescription</field>
        <field name="arch" type="xml">
            <list>
                <field name="appointment_id"/>
                <field name="pet_id"/>
                <field name="medicine_list"/>
            </list>
        </field>
    </record>

    <record id="vet_prescription_action" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">vet.prescription</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="vet_prescription_menu" name="Prescriptions" parent="vet_clinic_root" action="vet_prescription_action"
              groups="base.group_user"/>
</odoo>
