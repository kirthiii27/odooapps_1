<odoo>
    <record id="view_vet_vaccine_form" model="ir.ui.view">
        <field name="name">vet.vaccine.form</field>
        <field name="model">vet.vaccine</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vet_vaccine_tree" model="ir.ui.view">
        <field name="name">vet.vaccine.tree</field>
        <field name="model">vet.vaccine</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="action_vet_vaccine" model="ir.actions.act_window">
        <field name="name">Vaccines</field>
        <field name="res_model">vet.vaccine</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="vet_config_menu" name="Configuration" parent="vet_clinic_root" sequence="50"
              groups="base.group_user"/>

    <menuitem id="vet_vaccine_menu" name="Vaccines" parent="vet_config_menu" action="action_vet_vaccine" sequence="1"
              groups="base.group_user"/>
</odoo>